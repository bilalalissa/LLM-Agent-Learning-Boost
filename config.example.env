# LLM Agent Learning Boost configuration template.
# The native macOS app copies this file to:
# ~/Library/Application Support/LLM Agent Learning Boost/config.env

AI_ACCESS_METHOD=local_first
DEFAULT_AI_PROVIDER=local_auto
DEFAULT_AI_MODEL=qwen3:8b

# Local auto resolver. Local/LAN providers are tried first.
LOCAL_AI_PROVIDER_PRIORITY=mlx_lm_server,ollama,mlx_lm_cli,openai_compat,openai_subscription,openai,gemini,anthropic
LOCAL_AI_ALLOW_LAN=true
LOCAL_AI_HEALTH_TIMEOUT_MS=2500
LOCAL_AI_REQUIRE_CONFIRM_CLOUD_FALLBACK=true

# Local AI Router automatic startup and handshake.
LOCAL_AI_ROUTER_AUTOSTART=true
LOCAL_AI_ROUTER_BASE_URL=http://127.0.0.1:17640
LOCAL_AI_ROUTER_APP_PATH=/Applications/Local AI Router.app
LOCAL_AI_ROUTER_COMMAND=
LOCAL_AI_ROUTER_AUTO_APPLY=true
LOCAL_AI_ROUTER_AUTO_START_PROVIDER=true
LOCAL_AI_ROUTER_AUTO_INSTALL=false
LOCAL_AI_ROUTER_TIMEOUT_MS=12000
LOCAL_AI_ROUTER_BEARER_TOKEN=

# Ollama local or LAN.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=all-minilm
OLLAMA_OPENAI_COMPAT=true

# MLX-LM Server local or LAN.
MLX_LM_SERVER_BASE_URL=http://127.0.0.1:8080
MLX_LM_SERVER_MODEL=default_model
MLX_LM_SERVER_API_KEY=

# MLX-LM CLI direct local fallback.
MLX_LM_COMMAND=mlx_lm.generate
MLX_LM_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
MLX_LM_TIMEOUT_MS=180000

# LAN safety:
# - Do not expose local model servers to the public internet.
# - Prefer LAN-only firewall rules.
# - If a provider supports auth, configure it before exposing it beyond this Mac.
# - Non-local IPs/domains will be shown with a privacy/security warning.

OPENAI_AUTH_METHOD=subscription
OPENAI_SUBSCRIPTION_CLIENT=codex
OPENAI_CODEX_COMMAND=codex
OPENAI_CODEX_LOGIN_CHECK_COMMAND="codex login status"
OPENAI_CODEX_TIMEOUT_MS=180000

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

ANTHROPIC_AUTH_METHOD=api_key
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_COMPAT_AUTH_METHOD=api_key
OPENAI_COMPAT_API_KEY=replace-with-your-openai-compatible-api-key
OPENAI_COMPAT_BEARER_TOKEN=replace-with-your-openai-compatible-bearer-token
OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1

GEMINI_AUTH_METHOD=api_key
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_OAUTH_ACCESS_TOKEN=replace-with-your-gemini-oauth-access-token
GEMINI_OAUTH_TOKEN_FILE=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional fallback root for vault folders. The app also detects vaults
# registered in Obsidian, including iCloud vaults added through Obsidian.
VAULTS_ROOT=~/Documents/Obsidian-Vaults

# Automatically scan every vault's raw/inbox and raw/input folders for new files.
WATCH_INTERVAL_MS=5000
AUTO_INGEST_ON_START=true
AI_PROVIDER_TIMEOUT_MS=60000
INGEST_MAX_CHARS=60000
CHAT_MAX_FILES=24
CHAT_PORT=8789

# Local server binding. Use 127.0.0.1 for Mac-only access,
# or 0.0.0.0 only when you intentionally expose the local UI on your LAN.
MAC_BRIDGE_HOST=127.0.0.1
MAC_BRIDGE_TOKEN=
